# Output helpers                                                            {{{1
# ==============================================================================

EMCR_RED='\033[0;31m'
EMCR_GREEN='\033[0;32m'
EMCR_YELLOW='\033[0;33m'
EMCR_NO_COLOR='\033[0m'

emcr_success() { printf "${EMCR_GREEN}✔ %s${EMCR_NO_COLOR}\n" "$1"; }
emcr_warn()    { printf "${EMCR_YELLOW}▲ %s${EMCR_NO_COLOR}\n" "$1" >&2; }
emcr_error()   { printf "${EMCR_RED}✘ %s${EMCR_NO_COLOR}\n" "$1" >&2; }
emcr_info()    { printf "  %s\n" "$1"; }

# Behaviour helpers                                                         {{{1
# ==============================================================================

# Drop credentials inherited from the launching shell or the tmux server.
emcr_clear_aws_env() {
    unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
          AWS_SECURITY_TOKEN AWS_CREDENTIAL_EXPIRATION AWS_PROFILE \
          AWS_DEFAULT_PROFILE AWS_REGION AWS_DEFAULT_REGION
}

# emcr_use_profile <profile> <region>
emcr_use_profile() {
    emcr_clear_aws_env
    export AWS_PROFILE="$1"
    export AWS_REGION="$2"
    export AWS_DEFAULT_REGION="$2"
}

# Render an account id as its last four digits.
emcr_mask_account() {
    case "${1:-}" in
        "")  printf '<unset>' ;;
        ????*) printf '...%s' "${1#"${1%????}"}" ;;
        *)   printf '%s' "$1" ;;
    esac
}

emcr_port_listening() {
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

emcr_port_label() {
    case "$1" in
        "$EMCR_PORT_TDDC")      echo "port-forward" ;;
        "$EMCR_PORT_MD_API")    echo "api" ;;         
        "$EMCR_PORT_CONTAINER") echo "container" ;;   
        "$EMCR_PORT_TOOLS")     echo "tools" ;;       
        "$EMCR_PORT_BFF")       echo "bff" ;;         
        "$EMCR_PORT_RADAR")     echo "client" ;;      
        *)                      echo "port $1" ;;
    esac
}
